# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=127.0.0.1

# ─── CORS ─────────────────────────────────────────────
# اتركه فارغًا لاستخدام localhost فقط، أو ضع origins مفصولة بفواصل
CORS_ORIGIN=

# ─── Request body ─────────────────────────────────────
JSON_LIMIT=10mb

# ─── GitHub ───────────────────────────────────────────
# ممكن تحط التوكن هنا، أو تدخله من الواجهة ويتخزن في db
GITHUB_TOKEN=

# ─── AI Providers ─────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# مجلدات إضافية للبحث عن المشاريع (مفصولة بفاصلة)
PROJECT_ROOTS=

MASTER_KEY=

# ─── Application security ────────────────────────────
# Required automatically in production or when HOST is not loopback.
APP_ACCESS_TOKEN=
REQUIRE_AUTH=false
ENABLE_TERMINAL=true

# ─── Terminal (نسخة مشددة: whitelist إجباري + حدود أضيق) ──
TERMINAL_MODE=whitelist
TERMINAL_COMMANDS_FILE=
TERMINAL_AUDIT_LOG=true
TERMINAL_TIMEOUT=30000
TERMINAL_MAX_TIMEOUT=120000
TERMINAL_MAX_ARGS=16

# ─── Roles: user vs root (مشددة) ─────────────────────
# استخدم HASH فقط هنا (ولّده بـ node scripts/gen-root-hash.js).
# الباسورد النصي مرفوض في هذه النسخة إن وُجد HASH.
ROOT_PASSWORD=
ROOT_PASSWORD_HASH=
ROOT_TOKEN_TTL_MIN=10
